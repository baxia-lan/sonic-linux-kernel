"""SONiC Linux kernel — migrated from rules/linux-kernel.mk.

Downloads kernel source from Debian security pool, applies SONiC patches,
builds via dpkg-buildpackage. Produces linux-image and linux-headers .debs.
"""

package(default_visibility = ["//visibility:public"])

KERNEL_VERSION = "6.1.123"
KERNEL_SUBVERSION = "1"
KVERSION_SHORT = "6.1.0-29-2"
KVERSION = KVERSION_SHORT + "-amd64"

filegroup(
    name = "kernel_patches",
    srcs = glob(["patch/**"], allow_empty = True),
)

filegroup(
    name = "kernel_config",
    srcs = glob(["Makefile", "manage-config", "config*"], allow_empty = True),
)

genrule(
    name = "linux_kernel_debs",
    srcs = [":kernel_patches", ":kernel_config"],
    outs = [
        "linux-headers-" + KVERSION_SHORT + "-common_" + KERNEL_VERSION + "-" + KERNEL_SUBVERSION + "_all.deb",
        "linux-headers-" + KVERSION + "_" + KERNEL_VERSION + "-" + KERNEL_SUBVERSION + "_amd64.deb",
        "linux-image-" + KVERSION + "-unsigned_" + KERNEL_VERSION + "-" + KERNEL_SUBVERSION + "_amd64.deb",
    ],
    cmd = """
set -euo pipefail
# Temp dir must be under the Bazel execroot so that `docker run -v` can
# see it from the host docker daemon on Cloud Build (DinD). /tmp is
# not shared across the DinD boundary; /workspace is.
mkdir -p "$$PWD/.bazel-tmp"
STAGING=$$(mktemp -d -p "$$PWD/.bazel-tmp")

# Find the kernel source directory (contains Makefile)
SRC_DIR=""
for f in $(locations :kernel_config); do
  case "$$f" in */Makefile) SRC_DIR=$$(cd $$(dirname "$$f") && pwd); break;; esac
done
[ -z "$$SRC_DIR" ] && { echo "Cannot find kernel Makefile"; exit 1; }

docker run --rm --platform linux/amd64 \
  -v "$$SRC_DIR:/kernel-src:ro" \
  -v "$$STAGING:/output" \
  -e DEBIAN_FRONTEND=noninteractive \
  -e CONFIGURED_ARCH=amd64 \
  debian:bookworm-slim@sha256:4724b8cc51e33e398f0e2e15e18d5ec2851ff0c2280647e1310bc1642182655d \
  bash -o pipefail -c '
    unset SOURCE_DATE_EPOCH
    apt-get update -qq
    apt-get install -y -qq --no-install-recommends \
      build-essential dpkg-dev fakeroot debhelper bc rsync kmod cpio \
      python3 libelf-dev libssl-dev bison flex dwarves wget ca-certificates \
      xz-utils git stgit python3-jinja2 python3-dacite kernel-wedge quilt \
      dh-python lz4 zstd
    cd /tmp
    cp -a /kernel-src/* .
    git config --global user.email build@sonic
    git config --global user.name sonic
    # Run the SONiC kernel Makefile
    NPROC=$$(nproc 2>/dev/null || echo 4)
    # Remove linux-cpupower package from debian/control before build.
    # SONiC kernel config does not build cpupower, but the Debian
    # debian/control declares it, so dh_install fails looking for
    # debian/linux-cpupower.install. Write the sed script to a file
    # to avoid nested-quoting issues, then inject calls before each
    # fakeroot invocation in the Makefile.
    echo "/^Package: linux-cpupower/,/^$$/d" > /tmp/fix-cpupower.sed
    sed -i "s|DEB_BUILD_PROFILES=nodoc fakeroot|sed -i -f /tmp/fix-cpupower.sed debian/control; export DEB_BUILD_PROFILES=nodoc; fakeroot|" Makefile
    sed -i "s|fakeroot make -f debian/rules.gen -j|sed -i -f /tmp/fix-cpupower.sed debian/control; fakeroot make -f debian/rules.gen -j|" Makefile
    echo "=== Makefile cpupower patches ==="
    grep -n "cpupower" Makefile
    make DEST=/output CONFIGURED_ARCH=amd64 CONFIGURED_PLATFORM=vs SONIC_CONFIG_MAKE_JOBS=$$NPROC -j$$NPROC 2>&1 | tail -50
    echo "=== kernel debs ==="
    ls -lh /output/*.deb 2>/dev/null | head -5
  '

for out in $(OUTS); do
  base=$$(basename "$$out")
  if [ -f "$$STAGING/$$base" ]; then
    cp "$$STAGING/$$base" "$$out"
  else
    echo "FAIL: $$base not in staging"
    ls "$$STAGING"/*.deb 2>/dev/null || true
    exit 1
  fi
done
rm -rf "$$STAGING"
""",
    tags = ["requires-docker", "no-sandbox", "no-cache"],
)

genrule(
    name = "kernel_modules_tar",
    srcs = [":linux_kernel_debs"],
    outs = ["modules.tar.gz"],
    cmd = """
set -euo pipefail
# Temp dir must be under execroot for DinD mounts (see linux_kernel_debs).
mkdir -p "$$PWD/.bazel-tmp"
STAGING=$$(mktemp -d -p "$$PWD/.bazel-tmp")
FIRST_DEB=""
for f in $(SRCS); do
  case "$$f" in *linux-image-*) FIRST_DEB="$$f"; break;; esac
done
[ -z "$$FIRST_DEB" ] && { echo "No linux-image deb"; exit 1; }
ABS_DEB=$$(cd $$(dirname "$$FIRST_DEB") && pwd)/$$(basename "$$FIRST_DEB")
docker run --rm --platform linux/amd64 \
  -v "$$ABS_DEB:/image.deb:ro" \
  -v "$$STAGING:/output" \
  debian:bookworm-slim@sha256:4724b8cc51e33e398f0e2e15e18d5ec2851ff0c2280647e1310bc1642182655d \
  bash -c 'dpkg-deb -x /image.deb /tmp/root && tar -czf /output/modules.tar.gz -C /tmp/root lib/modules' 2>&1 | tail -3

for out in $(OUTS); do
  base=$$(basename "$$out")
  if [ -f "$$STAGING/$$base" ]; then
    cp "$$STAGING/$$base" "$$out"
  else
    echo "FAIL: $$base not in staging"
    ls "$$STAGING"/* 2>/dev/null || true
    exit 1
  fi
done
rm -rf "$$STAGING"
""",
    tags = ["requires-docker", "no-sandbox"],
)

genrule(
    name = "vmlinuz",
    srcs = [":linux_kernel_debs"],
    outs = ["vmlinuz-extracted"],
    cmd = """
set -euo pipefail
# Temp dir must be under execroot for DinD mounts (see linux_kernel_debs).
mkdir -p "$$PWD/.bazel-tmp"
STAGING=$$(mktemp -d -p "$$PWD/.bazel-tmp")
FIRST_DEB=""
for f in $(SRCS); do
  case "$$f" in *linux-image-*) FIRST_DEB="$$f"; break;; esac
done
[ -z "$$FIRST_DEB" ] && { echo "No linux-image deb"; exit 1; }
ABS_DEB=$$(cd $$(dirname "$$FIRST_DEB") && pwd)/$$(basename "$$FIRST_DEB")
docker run --rm --platform linux/amd64 \
  -v "$$ABS_DEB:/image.deb:ro" \
  -v "$$STAGING:/output" \
  debian:bookworm-slim@sha256:4724b8cc51e33e398f0e2e15e18d5ec2851ff0c2280647e1310bc1642182655d \
  bash -c 'dpkg-deb -x /image.deb /tmp/root && cp /tmp/root/boot/vmlinuz-* /output/vmlinuz' 2>&1 | tail -3

if [ -f "$$STAGING/vmlinuz" ]; then
  cp "$$STAGING/vmlinuz" $(OUTS)
else
  echo "FAIL: vmlinuz not in staging"
  ls "$$STAGING"/* 2>/dev/null || true
  exit 1
fi
rm -rf "$$STAGING"
""",
    tags = ["requires-docker", "no-sandbox"],
)

alias(name = "linux_image", actual = ":linux_kernel_debs", visibility = ["//visibility:public"])
alias(name = "linux_headers", actual = ":linux_kernel_debs", visibility = ["//visibility:public"])
